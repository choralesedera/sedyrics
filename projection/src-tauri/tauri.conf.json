{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LyriCSED Projection",
  "version": "0.1.0",
  "identifier": "mg.ankino.lyricsedprojection",
  "build": { "frontendDist": ".." },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "LyriCSED Projection", "width": 1400, "height": 860, "minWidth": 980, "minHeight": 660 }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "nsis": { "languages": ["French"], "displayLanguageSelector": false } }
  }
}